          </mxGeometry>
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-241" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="读出来的配置两分钟后就会从缓存列表中移除" vertex="1">
          <mxGeometry height="60" width="120" x="1150" y="4450" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-242" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="卸载策略：创建设置贴图和bitmap时会添加两个的引用计数，引用方销毁时引用数减一，引用归零时才真正销毁移除缓存，图片或fgui销毁释放的时候会调ILaya.loader.clearRes" vertex="1">
          <mxGeometry height="90" width="180.5" x="295.5" y="1117" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-243" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="240" width="381.92" x="486" y="1087" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-244" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="卸载策略：利用laya对图集资源的引用次数做判断，如果图集的引用次数等于0，可以销毁的时候就可以直接fgui.UIPackage.removePackage&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;packageItem也是用public texture?: Laya.Texture来做图片显示的，设置图集的时候会自动给包体图集加引用计数&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="220" x="610" y="2730" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-246" parent="1" style="whiteSpace=wrap;html=1;" value="加载出来的spine对象由消费者主动释放销毁" vertex="1">
          <mxGeometry height="60" width="120" x="1160" y="3730" as="geometry" />
        </mxCell>
        <mxCell id="p4A9s3r1vKkwnljfFEUw-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="资源inpool的时候检查当前缓存url大于5个的时候扣减最久未被使用的url相关的资源的引用数量，Res3DInfo持有资源实例化的引用数量，AbInfo.refnum是ab资源包的引用数量，各自引用数量为0时销毁，实例引用数小于等于0才会进url缓存列表" vertex="1">
          <mxGeometry height="80" width="310" x="1300" y="6670" as="geometry" />
