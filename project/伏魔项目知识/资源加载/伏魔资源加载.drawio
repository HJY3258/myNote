          <mxGeometry height="30" width="200" x="890" y="300" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-235" parent="1" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="pc文件夹内因为不适用astc压缩所以纹理没有放进.zb文件内而是独立存在提供部分公用，sj和sl有压缩所以全部放了进去" vertex="1">
          <mxGeometry height="95" width="140" x="1140.5" y="7240" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-237" parent="1" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="打包成zb有可能是因为打包成 .zb 后，一个模型就是一个下载任务，限流才有意义、才能精确控制同时下载多少个包。" vertex="1">
          <mxGeometry height="95" width="130" x="1135" y="6670" as="geometry" />
        </mxCell>
        <mxCell id="XfF0uzlHnH_BXcX1mvAM-240" edge="1" parent="1" source="XfF0uzlHnH_BXcX1mvAM-215" style="curved=1;endArrow=classic;html=1;rounded=0;exitX=1;exitY=1;exitDx=0;exitDy=0;miterlimit=4;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="6970" />
