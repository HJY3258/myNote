          <mxGeometry height="60" width="120" x="340" y="1754" as="geometry" />
        </mxCell>
        <mxCell id="JXDYsIx4Jfbe5A_JapXj-18" edge="1" parent="1" source="JXDYsIx4Jfbe5A_JapXj-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" target="JXDYsIx4Jfbe5A_JapXj-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IOwKRmme0ZNQYmLdkbvM-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="322" width="393" x="1108.5" y="2016" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="674" width="995" x="129.45999999999998" y="7190" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="根据微信官方文档来看pc端不用astc压缩是为了避开引擎层面的软解，避免不必要的性能消耗" vertex="1">
          <mxGeometry height="30" width="510" x="1135" y="7210" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-3" parent="1" style="whiteSpace=wrap;html=1;" value="从Texture2D.setCompressData来看laya还支持DXT，ETC，PVRTC这几种压缩格式" vertex="1">
          <mxGeometry height="60" width="340" x="1140.5" y="7350" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-4" parent="1" style="whiteSpace=wrap;html=1;" value="ETC：最初为移动设备开发，如今它是安卓的标准压缩方案，ETC1在OpenGL和OpenGL ES中都有支持。&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font color=&quot;#191b1f&quot; face=&quot;-apple-system, BlinkMacSystemFont, Helvetica Neue, PingFang SC, Microsoft YaHei, Source Han Sans SC, Noto Sans CJK SC, WenQuanYi Micro Hei, MiSans L3, Segoe UI, sans-serif&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;其原理简单来说，是将4x4 的像素块编码为2x4或4x2像素的两个块的方法，每个块指定一个基色，每个像素的颜色通过一个编码为相对于这些基色偏移的灰度值确定&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="340" x="1140" y="7430" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-5" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;font&gt;DXT：一种与组块有关的有损压缩算法，&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;由于版权专利一般用于Window平台&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;text-align: start; background-color: rgb(255, 255, 255); color: rgb(25, 27, 31);&quot;&gt;&lt;font color=&quot;#191b1f&quot; face=&quot;-apple-system, BlinkMacSystemFont, Helvetica Neue, PingFang SC, Microsoft YaHei, Source Han Sans SC, Noto Sans CJK SC, WenQuanYi Micro Hei, MiSans L3, Segoe UI, sans-serif&quot;&gt;其原理简单来说，是由一对低精度的“基色”来描述一个4x4的RGB像素块，并允许每个像素在这些基色之间指定一个插值。S3TC有多种变体，每种都是为特定类型的图像数据设计，但它们都是将4x4的像素块转换为64位或128位的数据。&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="339.5" x="1140.5" y="7540" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-6" parent="1" style="whiteSpace=wrap;html=1;" value="PVRTC：由于专利原因一般它只被用于苹果的设备&lt;div&gt;PVRTC不同于DXT和ETC这类基于块的算法，而将整张纹理分为了高频信号和低频信号，低频信号由两张低分辨率的图像A和B表示，这两张图在两个维度上都缩小了4倍，高频信号则是全分辨率但低精度的调制图像M，M记录了每个像素混合的权重。要解码时，A和B图像经过双线性插值（bilinearly）宽高放大4倍，然后与M图上的权重进行混合。&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="339.5" x="1140.5" y="7660" as="geometry" />
        </mxCell>
        <mxCell id="x7f_kTOFU1-BApHTU2u5-7" parent="1" style="whiteSpace=wrap;html=1;" value="ASTC：唯一一个不受专利权影响的压缩格式。ASTC在压缩率、图像质量、种类上都挺不错的，也正在逐步代替前三种，最大的缺点可能就是兼容性还不够完善和解码时间较长" vertex="1">
          <mxGeometry height="60" width="340" x="1140" y="7780" as="geometry" />
        </mxCell>
